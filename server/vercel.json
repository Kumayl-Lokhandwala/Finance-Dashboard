{
  "installCommand": "npm install --legacy-peer-deps",
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/build/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/kpi/(.*)", "dest": "server/index.js" },
    { "src": "/product/(.*)", "dest": "server/index.js" },
    { "src": "/transaction/(.*)", "dest": "server/index.js" },
    { "src": "/(.*)", "dest": "client/build/index.html" }
  ]
}
